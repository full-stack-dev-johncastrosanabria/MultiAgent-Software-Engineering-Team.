FAST_MODEL=qwen3.5:4b
DEEP_MODEL=qwen3.5:9b
CODING_MODEL=qwen3.5:9b
LOCAL_FIRST=false
MAX_LOCAL_RETRIES=1
MAX_LOCAL_REPAIRS=1
MAX_CLOUD_ESCALATIONS_PER_AGENT=1
MAX_CLOUD_ESCALATIONS_PER_RUN=3
# Reintentos de una etapa por errores transitorios de modelo antes de HITL.
MAX_MODEL_STAGE_RETRIES=1
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45
CLOUD_ROLE_TIMEOUT_SECONDS=120
# Local-first machines may need several minutes. The cloud demo uses 45 and no local retries.
OLLAMA_TIMEOUT_SECONDS=600
# Where the target project's commands execute: `process` (sandbox-exec on
# Darwin, Bubblewrap on Linux, refusing to run anywhere else) or `container`
# (Docker). A suite that starts its own containers — Testcontainers and
# equivalents — must use `process`: the quality container has no route to the
# Docker API, and mounting the host socket is refused (ADR 10).
QUALITY_RUNNER=process
# Maximum per QualityMCP operation, including cold dependency provisioning.
QUALITY_TIMEOUT_SECONDS=600
# Which tests the gate runs, stated by the operator (ADR 11). Empty runs the
# whole suite. The expression is expanded by the stack's own filter template
# (`-k` on python, `--filter` on dotnet); a stack that declares none refuses the
# run instead of silently ignoring the filter.
QUALITY_TEST_FILTER=
GEMINI_API_KEY=
# Optional independent Gemini route, selected explicitly as provider `google2`.
GEMINI_API_KEY_2=
# --- Estrategia de proveedores ---
# Primarios: Groq/Product, Mistral/Architecture+Developer, OpenRouter/Security.
# Primer fallback en otro proveedor; solo modelos validados por rol.
# Las cuotas pueden ser por modelo, cuenta o proveedor upstream.
# Testing y Reviewer son compuertas deterministas y no invocan modelo.
#
# Las cadenas por defecto viven en llm/cloud.py. Para sobreescribir un rol:
#   CLOUD_CHAIN_DEVELOPER=mistral:codestral-latest,groq:openai/gpt-oss-120b,mistral:mistral-small-latest,google:gemini-3.5-flash,google2:gemini-3.1-flash-lite
CLOUD_CHAIN_PRODUCT=
CLOUD_CHAIN_ARCHITECTURE=
CLOUD_CHAIN_DEVELOPER=
CLOUD_CHAIN_SECURITY=

# Mistral: el modo gratuito depende de tu cuenta; verifica tu plan en Studio.
MISTRAL_API_KEY=
# OpenRouter: los defaults usan :free y restringen el precio de tokens a cero.
OPEN_ROUTER_API_KEY=
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
CLOUD_ENABLED=true
WORKSPACE_ROOT=workspace/runs
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=160
RAG_TOP_K=4
RAG_FETCH_K=8
RAG_MIN_RELEVANCE=0.55
RAG_PERSIST_DIRECTORY=rag/chroma
GITHUB_PERSONAL_ACCESS_TOKEN=
